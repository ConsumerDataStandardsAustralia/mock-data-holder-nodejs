# the image is build from  https://github.com/ConsumerDataStandardsAustralia/accc-authorisation-server
FROM docker.io/consumerdatastandardsaustralia/mtls-gateway:0.2 AS build


WORKDIR /app

COPY configs/mtls-gateway/gateway-config.json /app/gateway-mtls/
COPY security/output/mtls-gateway/mtls-server.pfx /app/gateway-mtls/Certificates

